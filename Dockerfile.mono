# Ubuntu 22.04 LTS Base Image for Mono ASP.NET Web Forms
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install Mono Runtime and XSP4 Web Server
RUN apt-get update && apt-get install -y \
    mono-complete \
    mono-xsp4 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy application files
COPY . /app

EXPOSE 8080

# Serve ASP.NET Web Application
CMD ["xsp4", "--port=8080", "--root=/app/Solution.Web", "--nonstop"]
